root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.java]
indent_size = 4

[*.{xml,yml,yaml,json,js,ts,vue,scss,css}]
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是换行语法，不能删
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
