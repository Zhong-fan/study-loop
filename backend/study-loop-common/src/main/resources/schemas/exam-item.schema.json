{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "真题题目",
  "type": "object",
  "required": ["stem", "type", "score", "page"],
  "properties": {
    "stem": { "type": "string", "minLength": 5 },
    "type": { "enum": ["SINGLE", "MULTIPLE", "JUDGE", "SHORT", "COMPOSITE"] },
    "answer": { "type": "string" },
    "score": { "type": "number", "minimum": 0.5, "maximum": 50 },
    "page": { "type": "integer", "minimum": 1 },
    "knowledge": {
      "type": "string",
      "description": "这道题主要考的知识点名称，没有就留空"
    }
  },
  "additionalProperties": true
}
