{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studyloop.local/schemas/question-draft.schema.json",
  "title": "题目草稿",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "stem", "total_score", "difficulty", "bloom", "source", "knowledge", "evidence", "explain"],
  "properties": {
    "type": {
      "enum": ["SINGLE", "MULTIPLE", "JUDGE", "BLANK", "SUBJECTIVE", "COMPOSITE"]
    },
    "stem": { "type": "string", "minLength": 4, "maxLength": 2000 },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    },
    "answer": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "total_score": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "bloom": { "enum": ["REMEMBER", "UNDERSTAND", "APPLY", "ANALYZE"] },
    "source": { "enum": ["AI", "REAL", "EXAMPLE"] },
    "knowledge": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["knowledge_id", "weight", "role"],
        "properties": {
          "knowledge_id": { "type": "integer", "minimum": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "role": { "enum": ["PRIMARY", "RELATED", "CONFUSABLE"] }
        }
      }
    },
    "sub_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["no", "stem", "score", "answer", "rubric"],
        "properties": {
          "no": { "type": "integer", "minimum": 1 },
          "stem": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "exclusiveMinimum": 0 },
          "answer": { "type": "string", "minLength": 1 },
          "rubric": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["point", "score", "knowledge_id"],
              "properties": {
                "point": { "type": "string", "minLength": 1 },
                "score": { "type": "number", "exclusiveMinimum": 0 },
                "knowledge_id": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["material_id", "page", "quote"],
        "properties": {
          "material_id": { "type": "integer", "minimum": 1 },
          "page": { "type": "integer", "minimum": 1 },
          "quote": { "type": "string", "minLength": 2, "maxLength": 500 }
        }
      }
    },
    "explain": { "type": "string", "minLength": 4, "maxLength": 500 }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["SINGLE", "MULTIPLE", "JUDGE"] } }, "required": ["type"] },
      "then": { "required": ["options", "answer"] }
    },
    {
      "if": { "properties": { "type": { "const": "COMPOSITE" } }, "required": ["type"] },
      "then": { "required": ["sub_questions"] }
    }
  ]
}
