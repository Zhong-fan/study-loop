{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studyloop.local/schemas/page-doc.schema.json",
  "title": "页面解析结果",
  "type": "object",
  "additionalProperties": false,
  "required": ["page", "doc_type", "text"],
  "properties": {
    "page": { "type": "integer", "minimum": 1 },
    "doc_type": { "enum": ["SLIDE", "PDF", "IMAGE", "DOC"] },
    "text": { "type": "string", "maxLength": 20000 },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "text"],
        "properties": {
          "kind": { "enum": ["heading", "paragraph", "bullet", "code", "note"] },
          "level": { "type": "integer", "minimum": 1, "maximum": 6 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "formulas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["latex"],
        "properties": {
          "latex": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "context": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rows"],
        "properties": {
          "caption": { "type": "string", "maxLength": 200 },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["desc"],
        "properties": {
          "caption": { "type": "string", "maxLength": 200 },
          "desc": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "emphasis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "signal"],
        "properties": {
          "target": { "type": "string", "minLength": 1, "maxLength": 100 },
          "signal": { "enum": ["KEYWORD", "VISUAL", "REPEAT", "EXAMPLE", "OUTLINE"] },
          "quote": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "raw_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "has_answer": { "type": "boolean" },
          "answer_hint": { "type": "string", "maxLength": 500 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "maxLength": 200 }
    }
  }
}
