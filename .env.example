# 本地开发配置示例。
# 复制为仓库根目录的 .env 再填值；.env 已被 .gitignore 忽略。
# 启动脚本（runtime/start-all.vbs）只读取仓库根目录这一份 .env。

# ===== 必填：大模型 =====
AI_ENABLED=true
AI_BASE_URL=https://gw-260615.token.51mars.com/v1
AI_MODEL=deepseek-v4-1-flash
AI_API_KEY=

# ===== 安全：部署前必须修改（本地留空则使用默认值并打 WARN）=====
JWT_SECRET=
INTERNAL_TOKEN=

# ===== 可选 =====
# 管理员账号（首次启动时创建，已存在则跳过）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
# 是否启用 Seata；本地默认关闭，作答链路已不依赖它
SEATA_ENABLED=false
