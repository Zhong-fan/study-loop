# 本地开发配置示例。复制成 .env 再填值，.env 已被 .gitignore 忽略，不会进仓库。
#
# 用法一：起服务前让脚本读它（run-ai-service.cmd 已经这么做了）
# 用法二：docker compose --env-file .env up -d

# 大模型：任意 OpenAI 兼容接口都行
AI_ENABLED=true
AI_BASE_URL=https://gw-260615.token.51mars.com/v1
# 该中转站支持的模型见 /v1/models；gpt-4.1 不在其中
AI_MODEL=deepseek-v4-1-flash
# 在这里填你的 key，不要把填好的 .env 提交
AI_API_KEY=
